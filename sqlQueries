/*window Ranking function
Function	    Purpose                                     Handles duplicates
ROW_NUMBER()	Gives every row a unique sequential number	Different numbers
RANK()	        Gives equal values the same rank	        Skips ranks after ties
DENSE_RANK()	Gives equal values the same rank	        Does not skip ranks
NTILE()	        Divides ordered rows into a specified       Assigns bucket numbers
                number of groups	

rank -the products based on their sales
note-sql sorts data as first step

Integer based ranking-assign an integer for each row[top/bottom N analysis]
                      find top 3 products
                      in that row_number,rank,dense_rank,ntile
pecentage based ranking-assign apercentage to each row[distribution analysis]
                     it range between0 to 1 
                    -find top 20% product -this time percentage based ranking is good
                    -cume_dist()-calculates the cumulative distribution of a value within a set of values
                    ,percent_rank()-returns the percentile ranking number of a row

syntax:: Rank() over(partition by(optional) order by (must or required))
ntile(n)-has only expression others no need expression
*/

select OrderID,ProductID,Sales, 
Row_number()    over(order by Sales desc) row_number_Assign,
rank()          over(order by Sales desc) rank_Assign,
dense_rank()    over(order by Sales desc) dense_rank_Assign,
ntile(5)        over(order by Sales desc) five_bucket,--larger bucket come first ,
ntile(3)        over(order by Sales desc) three_bucket,--we created 3 bucket here 
cume_dist()     over(order by Sales desc) cume_dis_Assign,
percent_rank()  over(order by Sales desc) percent_rank_Assign
from Sales.Orders
