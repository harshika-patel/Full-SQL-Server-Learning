--Left Anti JOIN-return only unmatching rows from the left table
--The anti join answers one question: what has no match? A left row without a match has NULL in the B key, and the
--WHERE keeps only those rows.
--get all costomers who have not place any oder
select c.id , c.first_name,o.order_id,o.sales from customers as c left join orders as o
on c.id=o.customer_id where o.customer_id is null

--Right Anti JOIN--return only unmatching rows from the right table
--Only the rows from the right table that have no match on the left. In the book's tables: order 1004, whose customer 6
--does not exist.
--get all orders withput matching customers
select c.id , c.first_name,o.customer_id,o.order_id,o.sales from customers as c right join orders as o
on c.id=o.customer_id where c.id is null
--here i just change the order of tables and get same output like above (right anti join)and using left anti join
select c.id , c.first_name,o.customer_id,o.order_id,o.sales from orders as o left join customers as c
on c.id=o.customer_id where c.id is null

--Full Anti JOIN--return unmatching rows from the both the tables
--Only the rows from both tables that have no match on the other side.
--r
select c.id , c.first_name,o.customer_id,o.order_id,o.sales from customers as c full join orders as o
on c.id=o.customer_id where c.id is null or o.customer_id is null

--CROSS JOIN--table 1 rows X table 2 rows -5X4=20
--No key, no matching: every row meets every row. Count before you run it.
select c.id , c.first_name,o.order_id,o.sales from customers as c cross join orders as o

